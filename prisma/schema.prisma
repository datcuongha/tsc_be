generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model invoiceIt {
  soHd             Int
  kyHieuHd         String             @db.VarChar(20)
  ngayHd           String             @db.VarChar(50)
  loaiHinh         String             @db.VarChar(20)
  noiDung          String             @db.Text
  tienThue         Int
  tongTien         Int
  createDate       DateTime?          @db.Timestamp(0)
  userId           Int?
  ptThanhToan      String             @db.VarChar(50)
  mst              String?            @db.VarChar(20)
  tenNcc           String?            @db.VarChar(255)
  diaChi           String?            @db.VarChar(255)
  soDt             Int?
  email            String?            @db.VarChar(255)
  stk              String?            @db.VarChar(50)
  nganHang         String?            @db.VarChar(255)
  webSite          String?            @db.VarChar(255)
  soTienBangChu    String?            @db.VarChar(255)
  tyGia            Int?
  caNhan           String?            @db.VarChar(255)
  file             String?            @db.VarChar(255)
  id               Int                @id @default(autoincrement())
  modifiedDate     DateTime?          @db.Timestamp(0)
  status           Boolean?
  users            users?             @relation(fields: [userId], references: [userId], onDelete: NoAction, onUpdate: NoAction, map: "invoiceIt_ibfk_1")
  invoiceItDetails invoiceItDetails[]

  @@unique([soHd, kyHieuHd])
  @@index([userId], map: "userId")
}

model invoiceItDetails {
  id                Int       @id @default(autoincrement())
  danhSachHang      String    @db.VarChar(255)
  dvt               String    @db.VarChar(20)
  sl                Int
  donGia            Int
  thanhTienTruocVat Int
  loaiThue          String    @db.VarChar(5)
  tienThueDongHang  Int
  thanhTien         Int
  tongTien          Int
  userId            Int?
  createDate        DateTime? @db.Date
  invoiceItId       Int
  modifiedDate      DateTime? @db.Timestamp(0)
  status            Boolean?
  users             users?    @relation(fields: [userId], references: [userId], onDelete: NoAction, onUpdate: NoAction, map: "invoiceItDetails_ibfk_2")
  invoiceIt         invoiceIt @relation(fields: [invoiceItId], references: [id], onDelete: Cascade)

  @@index([userId], map: "userId")
  @@index([invoiceItId])
}

model users {
  userId            Int                 @id @default(autoincrement())
  userName          String?             @unique @db.VarChar(100)
  fullName          String?             @db.VarChar(255)
  pass              String?             @db.VarChar(255)
  email             String?             @db.VarChar(100)
  address           String?             @db.VarChar(255)
  brithday          DateTime?           @db.Timestamp(0)
  phone             String?             @db.VarChar(20)
  status            Boolean?
  logo              String?             @db.VarChar(255)
  refreshToken      String?             @db.VarChar(255)
  vaiTroId          Int?
  boPhanId          Int?
  createDate        DateTime?           @db.Timestamp(0)
  modifiedDate      DateTime?           @db.Timestamp(0)
  authType          String?             @default("local") @db.VarChar(50)
  managerId         Int?
  dataSoHoa         dataSoHoa[]
  dmLoaiVb          dmLoaiVb[]
  dmMaPhi           dmMaPhi[]
  invoiceIt         invoiceIt[]
  invoiceItDetails  invoiceItDetails[]
  phieuDatHang      phieuDatHang[]
  phieuDatHangDuyet phieuDatHangDuyet[]
  phieuDatHangTong  phieuDatHangTong[]
  powerBi           powerBi[]
  users             users?              @relation("usersTousers", fields: [managerId], references: [userId], onDelete: NoAction, onUpdate: NoAction, map: "fk_users_manager")
  other_users       users[]             @relation("usersTousers")
  vaiTro            vaiTro?             @relation(fields: [vaiTroId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "users_ibfk_1")
  boPhan            boPhan?             @relation(fields: [boPhanId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "users_ibfk_2")

  @@index([boPhanId], map: "boPhanId")
  @@index([vaiTroId], map: "vaiTroId")
  @@index([managerId], map: "fk_users_manager")
}

model powerBi {
  id           Int       @id @default(autoincrement())
  title        String?   @db.VarChar(255)
  link         String?   @db.VarChar(255)
  userId       Int?
  createDate   DateTime? @db.Timestamp(0)
  status       Boolean?
  modifiedDate DateTime? @db.Timestamp(0)
  location     String?   @db.VarChar(255)
  users        users?    @relation(fields: [userId], references: [userId], onDelete: NoAction, onUpdate: NoAction, map: "powerBi_ibfk_1")

  @@index([userId], map: "userId")
}

model boPhan {
  id           Int         @id @default(autoincrement())
  maBp         String?     @unique(map: "boPhan_maBp") @db.VarChar(50)
  name         String?     @db.VarChar(50)
  status       Boolean?
  createDate   DateTime?   @db.Timestamp(0)
  modifiedDate DateTime?   @db.Timestamp(0)
  dataSoHoa    dataSoHoa[]
  users        users[]
  vaiTro       vaiTro[]
}

model phanQuyen {
  id               Int                @id @default(autoincrement())
  name             String?            @db.VarChar(100)
  code             String?            @unique(map: "code") @db.VarChar(100)
  module           String?            @db.VarChar(100)
  status           Boolean?
  createDate       DateTime?          @db.Timestamp(0)
  modifiedDate     DateTime?          @db.Timestamp(0)
  vaiTro_phanQuyen vaiTro_phanQuyen[]
}

model vaiTro {
  id               Int                @id @default(autoincrement())
  name             String?            @db.VarChar(50)
  dienGiai         String?            @db.VarChar(50)
  status           Boolean?
  createDate       DateTime?          @db.Timestamp(0)
  modifiedDate     DateTime?          @db.Timestamp(0)
  boPhanId         Int?
  users            users[]
  boPhan           boPhan?            @relation(fields: [boPhanId], references: [id], onDelete: Cascade, map: "vaiTro_ibfk_1")
  vaiTro_phanQuyen vaiTro_phanQuyen[]

  @@index([boPhanId], map: "boPhanId")
}

model vaiTro_phanQuyen {
  vaiTroId    Int
  phanQuyenId Int
  vaiTro      vaiTro    @relation(fields: [vaiTroId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "vaiTro_phanQuyen_ibfk_1")
  phanQuyen   phanQuyen @relation(fields: [phanQuyenId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "vaiTro_phanQuyen_ibfk_2")

  @@id([vaiTroId, phanQuyenId])
  @@index([phanQuyenId], map: "phanQuyenId")
}

model history {
  id          Int       @id @default(autoincrement())
  userEdit    String?   @db.VarChar(100)
  module      String?   @db.VarChar(50)
  action      String?   @db.VarChar(50)
  recordId    String?   @db.VarChar(100)
  description String?   @db.Text
  oldData     Json?
  newData     Json?
  createDate  DateTime? @default(now()) @db.Timestamp(0)

  @@index([createDate], map: "idx_created_at")
  @@index([module], map: "idx_module")
  @@index([userEdit], map: "idx_user")
}

model dmncc {
  id           Int        @id @default(autoincrement())
  maNcc        String?    @unique(map: "maNcc") @db.VarChar(20)
  tenNcc       String?    @db.VarChar(150)
  email        String?    @db.VarChar(150)
  phone        String?    @db.VarChar(12)
  diaChi       String?    @db.VarChar(255)
  mst          String?    @db.VarChar(20)
  congTy       String?    @db.VarChar(150)
  noteHd       String?    @db.VarChar(150)
  vat          String?    @db.VarChar(10)
  status       Boolean?
  createDate   DateTime?  @db.Timestamp(0)
  modifiedDate DateTime?  @db.Timestamp(0)
  dmhhFast     dmhhFast[]
}

model attributes {
  id             Int       @id @default(autoincrement())
  kiotProductId  Int?
  attributeName  String?   @db.VarChar(20)
  attributeValue String?   @db.VarChar(20)
  dmhhKiot       dmhhKiot? @relation(fields: [kiotProductId], references: [kiotProductId], onDelete: Cascade, map: "attributes_ibfk_1")

  @@unique([kiotProductId, attributeName], map: "kiotProductId_attributeName")
}

model dmhhKiot {
  id                   Int                  @id @default(autoincrement())
  createdDate          String?              @db.VarChar(255)
  masterCode           String?              @db.VarChar(50)
  masterProductId      Int?
  tradeMarkName        String?              @db.VarChar(50)
  tradeMarkId          Int?
  taxType              String?              @db.VarChar(255)
  taxRate              String?              @db.VarChar(50)
  taxname              String?              @db.VarChar(50)
  kiotProductId        Int?                 @unique(map: "dmhhKiot_kiotProductId")
  retailerId           Int?
  code                 String?              @db.VarChar(100)
  barCode              String?              @db.VarChar(50)
  name                 String?              @db.VarChar(255)
  fullName             String?              @db.VarChar(255)
  categoryId           Int?
  categoryName         String?              @db.VarChar(50)
  allowsSale           Boolean?
  type                 Int?
  hasVariants          Boolean?
  basePrice            Decimal?             @db.Decimal(18, 4)
  weight               Int?
  unit                 String?              @db.VarChar(20)
  conversionValue      Int?
  modifiedDate         String?              @db.VarChar(255)
  isActive             Boolean?
  description          String?              @db.VarChar(255)
  isRewardPoint        Boolean?
  isLotSerialControl   Boolean?
  isBatchExpireControl Boolean?
  orderTemplate        String?              @db.VarChar(255)
  attributes           attributes[]
  dmhhFast             dmhhFast[]
  dmhhKiotTax          dmhhKiotTax[]
  dnhhKiotPurchaseTax  dnhhKiotPurchaseTax?
  inventoriesKiot      inventoriesKiot[]
}

model dmhhKiotTax {
  id            Int       @id @default(autoincrement())
  kiotProductId Int?
  taxId         Int?
  name          String?   @db.VarChar(30)
  value         Decimal?  @db.Decimal(18, 4)
  dmhhKiot      dmhhKiot? @relation(fields: [kiotProductId], references: [kiotProductId], onDelete: Cascade, map: "dmhhKiotTax_ibfk_1")

  @@unique([kiotProductId, taxId], map: "kiotProductId_taxId")
}

model dnhhKiotPurchaseTax {
  id            Int       @id @default(autoincrement())
  kiotProductId Int?      @unique(map: "kiotProductId")
  taxId         Int?
  value         Decimal?  @db.Decimal(18, 4)
  name          String?   @db.VarChar(20)
  dmhhKiot      dmhhKiot? @relation(fields: [kiotProductId], references: [kiotProductId], onDelete: Cascade, map: "dnhhKiotPurchaseTax_ibfk_1")
}

model inventoriesKiot {
  id             Int       @id @default(autoincrement())
  kiotProductId  Int?
  productCode    String?   @db.VarChar(30)
  productName    String?   @db.VarChar(255)
  branchId       Int?
  branchName     String?   @db.VarChar(30)
  cost           Decimal?  @db.Decimal(18, 4)
  onHand         Int?
  reserved       Int?
  actualReserved Int?
  minQuantity    Int?
  maxQuantity    Int?
  isActive       Boolean?
  onOrder        Int?
  dmhhKiot       dmhhKiot? @relation(fields: [kiotProductId], references: [kiotProductId], onDelete: Cascade, map: "inventoriesKiot_ibfk_1")

  @@unique([kiotProductId, branchId], map: "inventoriesKiot")
}

model dmhhFast {
  id            Int       @id @default(autoincrement())
  maNcc         String?   @db.VarChar(20)
  maHang        String?   @unique(map: "maHang") @db.VarChar(50)
  kiotProductId Int?
  barcode       String?   @db.VarChar(20)
  tenHang       String?   @db.VarChar(255)
  giaMua        Int?
  vat           String?   @db.VarChar(10)
  giaBan        Int?
  dvt           String?   @db.VarChar(50)
  status        Boolean?
  createDate    DateTime? @db.Timestamp(0)
  modifiedDate  DateTime? @db.Timestamp(0)
  dmncc         dmncc?    @relation(fields: [maNcc], references: [maNcc], onDelete: Cascade, map: "dmhhFast_ibfk_1")
  dmhhKiot      dmhhKiot? @relation(fields: [kiotProductId], references: [kiotProductId], onDelete: Cascade, map: "dmhhFast_ibfk_2")

  @@index([maNcc], map: "maNcc")
  @@index([kiotProductId], map: "kiotProductId")
}

model synsTimeKiot {
  id      Int     @id @default(autoincrement())
  keyName String? @unique(map: "keyName") @db.VarChar(255)
  value   String? @db.VarChar(255)
}

model dataSoHoa {
  id              Int         @id @default(autoincrement())
  soVb            String?     @db.VarChar(100)
  noiDung         String?     @db.VarChar(255)
  ngayVb          DateTime?   @db.DateTime(0)
  loaiVb          Int?
  boPhanId        Int?
  parentId        Int?
  status          Boolean?
  createDate      DateTime?   @db.Timestamp(0)
  modifiedDate    DateTime?   @db.Timestamp(0)
  userId          Int?
  dmLoaiVbId      Int?
  maPhiId         Int?
  dataSoHoa       dataSoHoa?  @relation("dataSoHoaTodataSoHoa", fields: [parentId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "FK_DATA_SOHOA_PARENT")
  other_dataSoHoa dataSoHoa[] @relation("dataSoHoaTodataSoHoa")
  users           users?      @relation(fields: [userId], references: [userId], onDelete: NoAction, onUpdate: NoAction, map: "dataSoHoa_ibfk_1")
  boPhan          boPhan?     @relation(fields: [boPhanId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "dataSoHoa_ibfk_2")
  dmLoaiVb        dmLoaiVb?   @relation(fields: [dmLoaiVbId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "dataSoHoa_ibfk_3")
  dmMaPhi         dmMaPhi?    @relation(fields: [maPhiId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "dataSoHoa_ibfk_4")

  @@index([userId], map: "userId")
  @@index([parentId], map: "FK_DATA_SOHOA_PARENT")
  @@index([boPhanId], map: "boPhanId")
  @@index([dmLoaiVbId], map: "dmLoaiVbId")
  @@index([maPhiId], map: "maPhiId")
}

model dmLoaiVb {
  id           Int         @id @default(autoincrement())
  userId       Int?
  maLoaiVb     String?     @unique(map: "maLoaiVb") @db.VarChar(50)
  name         String?     @db.VarChar(100)
  status       Boolean?
  createDate   DateTime?   @db.Timestamp(0)
  modifiedDate DateTime?   @db.Timestamp(0)
  dataSoHoa    dataSoHoa[]
  users        users?      @relation(fields: [userId], references: [userId], onDelete: NoAction, onUpdate: NoAction, map: "dmLoaiVb_ibfk_1")

  @@index([userId], map: "userId")
}

model dmMaPhi {
  id            Int             @id @default(autoincrement())
  userId        Int?
  maPhi         Int?            @unique(map: "maPhi")
  tenPhi        String?         @db.VarChar(255)
  noiDung       String?         @db.VarChar(255)
  status        Boolean?
  createDate    DateTime?       @db.Timestamp(0)
  modifiedDate  DateTime?       @db.Timestamp(0)
  dataSoHoa     dataSoHoa[]
  users         users?          @relation(fields: [userId], references: [userId], onDelete: NoAction, onUpdate: NoAction, map: "dmMaPhi_ibfk_1")
  dmMaPhiDetail dmMaPhiDetail[]

  @@index([userId], map: "userId")
}

model dmMaPhiDetail {
  id       Int      @id @default(autoincrement())
  maPhi    Int?
  doiTuong String?  @db.VarChar(255)
  dmMaPhi  dmMaPhi? @relation(fields: [maPhi], references: [maPhi], onDelete: Cascade, map: "dmMaPhiDetail_ibfk_1")

  @@index([maPhi], map: "maPhi")
}

model detailPhieuDatHang {
  id            Int           @id @default(autoincrement())
  maPhieuId     Int?
  maHang        String?       @db.VarChar(15)
  tenSp         String?       @db.VarChar(255)
  dvt           String?       @db.VarChar(10)
  donGia        Decimal?      @db.Decimal(18, 4)
  giamGia       Decimal?      @db.Decimal(18, 4)
  thueSuat      String?       @db.VarChar(10)
  soLuong       Int?
  giaBan        Int?
  kySoLieu      String?       @db.VarChar(255)
  ghiChuHangHoa String?       @db.VarChar(255)
  canhBao       String?       @db.VarChar(255)
  slCoTheDat    String?       @db.VarChar(255)
  tonCuoi       Int?
  slKhoDat      Int?
  slTonToiUu    Int?
  slBanCuoi     Int?
  slNhapNccCuoi Int?
  ngayKhoDat    DateTime?     @db.Timestamp(0)
  phieuDatHang  phieuDatHang? @relation(fields: [maPhieuId], references: [id], onDelete: Cascade, map: "detailPhieuDatHang_ibfk_1")

  @@index([maPhieuId], map: "maPhieuId")
}

model detailPhieuDeXuat {
  id             Int           @id @default(autoincrement())
  maPhieuId      Int?
  chiNhanh       String?       @db.VarChar(20)
  maHang         String?       @db.VarChar(255)
  tenNhaCungCap  String?       @db.VarChar(255)
  tenHang        String?       @db.VarChar(255)
  nhapChuyen     Int?
  xuatBan        Int?
  tonCuoi        Int?
  slKhoDat       Int?
  giaVon         Int?
  giaBan         Int?
  maPhieuDatHang String?       @db.VarChar(255)
  ghiChu         String?       @db.VarChar(255)
  thuMuaNhap     Int?
  ngayKhoDat     DateTime?     @db.Timestamp(0)
  nhapNcc        Int?
  phieuDatHang   phieuDatHang? @relation(fields: [maPhieuId], references: [id], onDelete: Cascade, map: "detailPhieuDeXuat_ibfk_1")

  @@index([maPhieuId], map: "maPhieuId")
}

model phieuDatHang {
  id                 Int                  @id @default(autoincrement())
  maPhieu            String?              @db.VarChar(50)
  tenNcc             String?              @db.VarChar(255)
  congTy             String?              @db.VarChar(255)
  diaChi             String?              @db.VarChar(255)
  mst                String?              @db.VarChar(20)
  ghiChuHopDong      String?              @db.VarChar(255)
  createDate         DateTime?            @db.Timestamp(0)
  modifiedDate       DateTime?            @db.Timestamp(0)
  userId             Int?
  status             Boolean?
  maDatHangNhap      String?              @db.VarChar(255)
  toDate             DateTime?            @db.Timestamp(0)
  fromDate           DateTime?            @db.Timestamp(0)
  thoiGianGiaoHang   Int?
  detailPhieuDatHang detailPhieuDatHang[]
  detailPhieuDeXuat  detailPhieuDeXuat[]
  users              users?               @relation(fields: [userId], references: [userId], onDelete: NoAction, onUpdate: NoAction, map: "phieuDatHang_ibfk_1")

  @@index([userId], map: "userId")
}

model phieuDatHangDetail {
  id               Int               @id @default(autoincrement())
  phieuId          Int?
  maHang           String?           @db.VarChar(15)
  tenSp            String?           @db.VarChar(255)
  dvt              String?           @db.VarChar(10)
  donGia           Decimal?          @db.Decimal(18, 4)
  giamGia          Decimal?          @db.Decimal(18, 4)
  thueSuat         String?           @db.VarChar(10)
  soLuong          Int?
  soLuongPGDDuyet  Int?
  soLuongGDDuyet   Int?
  giaBan           Int?
  kySoLieu         String?           @db.VarChar(255)
  ghiChuHangHoa    String?           @db.VarChar(255)
  canhBao          String?           @db.VarChar(255)
  slCoTheDat       String?           @db.VarChar(255)
  tonCuoi          Int?
  slKhoDat         Int?
  slTonToiUu       Int?
  slBanCuoi        Int?
  slNhapNccCuoi    Int?
  ngayKhoDat       DateTime?         @db.Timestamp(0)
  phieuDatHangTong phieuDatHangTong? @relation(fields: [phieuId], references: [id], onDelete: Cascade, map: "phieuDatHangDetail_ibfk_1")

  @@index([phieuId], map: "phieuId")
}

model phieuDatHangTong {
  id                     Int                        @id @default(autoincrement())
  maPhieu                String                     @db.VarChar(100)
  tenNcc                 String                     @db.VarChar(255)
  congTy                 String?                    @db.VarChar(255)
  diaChi                 String?                    @db.VarChar(255)
  mst                    String?                    @db.VarChar(20)
  ghiChuHopDong          String?                    @db.VarChar(255)
  trangThai              phieuDatHangTong_trangThai @default(NHAP)
  nguoiGui               Int?
  ngayGui                DateTime?                  @db.DateTime(0)
  phieuGocId             Int?
  lyDoTraLai             String?                    @db.Text
  thoiGianGiaoHang       Int?
  createDate             DateTime?                  @default(now()) @db.Timestamp(0)
  modifiedDate           DateTime?                  @default(now()) @db.Timestamp(0)
  toDate                 DateTime?                  @default(now()) @db.Timestamp(0)
  fromDate               DateTime?                  @default(now()) @db.Timestamp(0)
  phieuDatHangNhap       String?                    @db.VarChar(255)
  phieuDatHangDetail     phieuDatHangDetail[]
  phieuDatHangDuyet      phieuDatHangDuyet[]
  users                  users?                     @relation(fields: [nguoiGui], references: [userId], onDelete: NoAction, onUpdate: NoAction, map: "phieuDatHangTong_ibfk_1")
  phieuDatHangTong       phieuDatHangTong?          @relation("phieuDatHangTongTophieuDatHangTong", fields: [phieuGocId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "phieuDatHangTong_ibfk_2")
  other_phieuDatHangTong phieuDatHangTong[]         @relation("phieuDatHangTongTophieuDatHangTong")
  phieuDeXuatDetail      phieuDeXuatDetail[]
  xntDetail              xntDetail[]

  @@index([createDate], map: "idx_createDate")
  @@index([maPhieu], map: "idx_maPhieu")
  @@index([nguoiGui], map: "idx_nguoiGui")
  @@index([phieuGocId], map: "idx_phieuGoc")
  @@index([trangThai], map: "idx_trangThai")
}

model phieuDeXuatDetail {
  id               Int               @id @default(autoincrement())
  phieuId          Int?
  chuThich         String?           @db.VarChar(255)
  chiNhanh         String?           @db.VarChar(20)
  maHang           String?           @db.VarChar(255)
  tenNhaCungCap    String?           @db.VarChar(255)
  tenHang          String?           @db.VarChar(255)
  nhapChuyen       Int?
  nhapNcc          Int?
  xuatBan          Int?
  tonCuoi          Int?
  slKhoDat         Int?
  giaVon           Int?
  giaBan           Int?
  canhBao          String?           @db.VarChar(255)
  ghiChuKho        String?           @db.VarChar(255)
  thuMuaNhap       Int?
  ngayKhoDat       DateTime?         @db.Timestamp(0)
  phieuDatHangNhap String?           @db.VarChar(50)
  phieuDatHangTong phieuDatHangTong? @relation(fields: [phieuId], references: [id], onDelete: Cascade, map: "phieuDeXuatDetail_ibfk_1")

  @@index([phieuId], map: "phieuId")
}

model phieuDatHangDuyet {
  id               Int                          @id @default(autoincrement())
  phieuId          Int
  userId           Int
  capDuyet         Int
  trangThai        phieuDatHangDuyet_trangThai? @default(CHO_DUYET)
  ngayDuyet        DateTime?                    @db.DateTime(0)
  ghiChu           String?                      @db.Text
  createDate       DateTime?                    @default(now()) @db.Timestamp(0)
  phieuDatHangTong phieuDatHangTong             @relation(fields: [phieuId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "phieuDatHangDuyet_ibfk_1")
  users            users                        @relation(fields: [userId], references: [userId], onDelete: NoAction, onUpdate: NoAction, map: "phieuDatHangDuyet_ibfk_2")

  @@unique([phieuId, capDuyet, userId], map: "uk_phieu_cap_user")
  @@index([capDuyet], map: "idx_capDuyet")
  @@index([phieuId], map: "idx_phieu")
  @@index([trangThai], map: "idx_trangThai")
  @@index([userId], map: "idx_user")
}

model xntDetail {
  id               Int               @id @default(autoincrement())
  phieuId          Int?
  maHang           String?           @db.VarChar(255)
  chiNhanh         String?           @db.VarChar(20)
  tenNhaCungCap    String?           @db.VarChar(255)
  nhapChuyen       Int?
  xuatBan          Int?
  tonCuoi          Int?
  slTonToiUu       Int?
  canhBao          String?           @db.VarChar(255)
  phieuDatHangTong phieuDatHangTong? @relation(fields: [phieuId], references: [id], onDelete: Cascade, map: "xntDetail_ibfk_1")

  @@index([phieuId], map: "phieuId")
}

model dmChiNhanh {
  id           Int       @id @default(autoincrement())
  tenKho       String?   @db.VarChar(100)
  createDate   DateTime? @db.Timestamp(0)
  modifiedDate DateTime? @db.Timestamp(0)
  status       Boolean?
}

model fileTemp {
  id           Int       @id @default(autoincrement())
  fileName     String?   @db.VarChar(255)
  file         Bytes
  createDate   DateTime? @db.Timestamp(0)
  modifiedDate DateTime? @db.Timestamp(0)
}

enum phieuDatHangTong_trangThai {
  NHAP
  CHO_DUYET
  DA_DUYET
  TRA_LAI
  DA_IN
}

enum phieuDatHangDuyet_trangThai {
  CHO_DUYET
  DA_DUYET
  TU_CHOI
  MAT_LUOC
